# Kafka Configuration

#kafka brokers should be in the format: host:port,host:port,...
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094

# Kafka client configuration
API_CLIENT_ID=ledger-flow-api
LEDGER_CLIENT_ID=ledger-flow-ledger
RISK_CLIENT_ID=ledger-flow-risk
NOTIFICATION_CLIENT_ID=ledger-flow-notification

# Kafka consumer configuration
LEDGER_GROUP_ID=ledger-group
RISK_GROUP_ID=risk-group
NOTIFICATION_GROUP_ID=notification-group

# Kafka topics
TOPIC_TRANSACTION_CREATED=ledger-flow.transaction.created.v1
TOPIC_TRANSACTION_UPDATED=ledger-flow.transaction.updated.v1

TOPIC_LEDGER_UPDATED=ledger-flow.ledger.updated.v1
TOPIC_NOTIFICATION_SEND=ledger-flow.notification.send.v1
TOPIC_RISK_ANALYZED=ledger-flow.risk.analyzed.v1

#retry and dlq configuration
TOPIC_TRANSACTION_RETRY=ledger-flow.transaction.retry
TOPIC_TRANSACTION_DLQ=ledger-flow.transaction.dlq

#PARTITION STRATEGY
KAFKA_PARTITION_KEY=userId

#CONSUMER SETTINGS
KAFKA_MAX_RETRY=5
KAFKA_RETRY_DELAY_MS=5000


# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
