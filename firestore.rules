rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🔒 Allow authenticated users to read/write their own data
    
    // 👤 Customers collection
    match /customers/{customerId} {
      // Admin & Subadmin can read all customers
      // Normal user can only read their own customers
      allow read: if request.auth != null && 
                    (request.auth.token.role in ["admin", "subadmin"] ||
                     resource.data.uid == request.auth.uid);
      
      // Only owner can write/update/delete
      allow write: if request.auth != null && 
                      request.auth.uid == resource.data.uid;
      
      // Create new customer (anyone authenticated)
      allow create: if request.auth != null && 
                       request.resource.data.uid == request.auth.uid;
    }

    // 💰 Transactions collection
    match /transactions/{transactionId} {
      // Admin & Subadmin can read all transactions
      // Normal user can only read their own transactions
      allow read: if request.auth != null && 
                    (request.auth.token.role in ["admin", "subadmin"] ||
                     resource.data.uid == request.auth.uid);
      
      // Only owner can write/update/delete
      allow write: if request.auth != null && 
                      request.auth.uid == resource.data.uid;
      
      // Create new transaction (anyone authenticated)
      allow create: if request.auth != null && 
                       request.resource.data.uid == request.auth.uid;
    }

    // 📊 Dashboard data (if needed)
    match /dashboard/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 📚 Ledger collection
    match /ledger/{ledgerId} {
      allow read: if request.auth != null && 
                    (request.auth.token.role in ["admin", "subadmin"] ||
                     resource.data.uid == request.auth.uid);
      
      allow write: if request.auth != null && 
                      request.auth.uid == resource.data.uid;
      
      allow create: if request.auth != null && 
                       request.resource.data.uid == request.auth.uid;
    }

    // 🚫 Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
